# Copy to .env and fill in. Never commit the real .env.

# Signs the login cookie (web/auth.py) - long random value, e.g.
# `python -c "import secrets; print(secrets.token_hex(32))"`
SESSION_SECRET=

# Encrypts each user's own IBKR credentials at rest (src/secrets_store.py) -
# `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
CREDENTIALS_ENCRYPTION_KEY=

# IB Gateway host - always 127.0.0.1 on the same box as everything else here.
IBKR_HOST=127.0.0.1

# Client ids for the Scanner/Executor/order-exec connections. Each user's
# Executor connects with its own IBKR login (on its own port - see
# src/gateway_provisioning.py) so these ids only need to be unique WITHIN one
# user's own Gateway connection, not globally.
IBKR_CYCLE_CLIENT_ID=2
IBKR_EXEC_CLIENT_ID=3
IBKR_ACCOUNT_REFRESH_CLIENT_ID=5

# Admin-only Telegram alerts (Gateway/Executor errors, admin's own trade
# events) - leave blank to disable. See src/notify.py.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
