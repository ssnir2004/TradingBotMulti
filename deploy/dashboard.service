[Unit]
Description=TradingBotMulti Dashboard (FastAPI, run_dashboard.py)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tradingbotmulti
WorkingDirectory=/opt/tradingbotmulti
ExecStart=/opt/tradingbotmulti/.venv/bin/python /opt/tradingbotmulti/run_dashboard.py
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
