[Unit]
Description=IB Gateway - LIVE for user %i (headless, via IBC)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tradingbotmulti
WorkingDirectory=/opt/tradingbotmulti
# always, not on-failure - a missed 2FA push exits IBC cleanly, which
# on-failure never restarts, leaving the unit stuck dead until someone
# notices and restarts it by hand (same reasoning as TradingBot's own
# ibgateway-live.service).
ExecStart=/opt/tradingbotmulti/deploy/ibc/start-gateway.sh %i
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
